{
  "name": "voicebox",
  "version": "1.0.0",
  "description": "Speech restoration using lip movements and AI — for people with dysphonia or aphasia.",
  "main": "main.js",
  "author": "Karina",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.voicebox.app",
    "productName": "VoiceBox",
    "directories": { "output": "release" },
    "copyright": "Copyright © 2025",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../voicebox/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../voicebox/electron-serve.mjs",
        "to": "frontend/electron-serve.mjs"
      },
      {
        "from": "../voicebox-be/dist/voicebox_backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoiceBox"
    },
    "dmg": {
      "title": "Install VoiceBox"
    }
  }
}
